  {
    "_createdAt": "2026-03-08T18:33:06Z",
    "_id": "lesson-formula-roi",
    "_rev": "rzkYjmGEGnbnpQO2CFLvYX",
    "_type": "lesson",
    "_updatedAt": "2026-03-08T18:33:06Z",
    "content": [
      {
        "_key": "b1",
        "_type": "block",
        "children": [
          {
            "_key": "s1",
            "_type": "span",
            "text": "Что такое ROI миссии?"
          }
        ],
        "style": "h2"
      },
      {
        "_key": "b2",
        "_type": "block",
        "children": [
          {
            "_key": "s2",
            "_type": "span",
            "text": "ROI (Return on Investment) миссии = Очки ÷ Время выполнения. Это формула, которая помогает приоритизировать миссии: сначала делаем те, где ROI максимальный."
          }
        ],
        "style": "normal"
      },
      {
        "_key": "b3",
        "_type": "block",
        "children": [
          {
            "_key": "s3",
            "_type": "span",
            "text": "Пороги ROI"
          }
        ],
        "style": "h3"
      },
      {
        "_key": "b4",
        "_type": "block",
        "children": [
          {
            "_key": "s4",
            "_type": "span",
            "text": "ROI > 0.6 — приоритетная миссия. 0.4–0.6 — рассмотреть. < 0.4 — пропустить или делать в последнюю очередь."
          }
        ],
        "style": "normal"
      }
    ],
    "courseSlug": "strategiya-igry-robotov",
    "isFree": true,
    "order": 1,
    "rubricCriterion": "IDENTIFY",
    "rubricLevel": "EXCEEDS",
    "slug": {
      "_type": "slug",
      "current": "formula-roi"
    },
    "tip": "ROI > 0.6 — приоритет. Считай ROI для каждой миссии до написания маршрута.",
    "title": "Формула ROI",
    "videoUrl": "https://www.youtube.com/watch?v=dQw4w9WgXcQ"
  },
